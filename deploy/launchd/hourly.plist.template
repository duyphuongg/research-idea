<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- POD Trend Radar: mỗi giờ (phút 30): khoảnh khắc NFL từ Google Trends + tin Telegram. Cài bằng `make install-hourly`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/backend/.venv/bin/python</string>
    <string>scripts/hourly.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__/backend</string>
  <key>StartCalendarInterval</key>
  <dict><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/backend/data/logs/hourly.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/backend/data/logs/hourly.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

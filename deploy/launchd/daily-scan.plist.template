<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- POD Trend Radar: quét tất cả nguồn mỗi ngày. Cài bằng `make install-daily`. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/backend/.venv/bin/python</string>
    <string>scripts/daily_scan.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT__/backend</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT__/backend/data/logs/daily-scan.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/backend/data/logs/daily-scan.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
